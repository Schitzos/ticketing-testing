{
  "openapi": "3.0.1",
  "info": {
    "title": "5. Notification Service API",
    "description": "Push subscription mobile. Email dikirim dari event (docs/contracts/events).",
    "version": "1.0.0",
    "contact": {
      "name": "Tim PT. Tiket Sampai Nonton Sentosa"
    }
  },
  "tags": [
    {
      "name": "notification"
    },
    {
      "name": "ops"
    }
  ],
  "paths": {
    "/api/v1/push-subscriptions": {
      "post": {
        "summary": "Daftarkan token push untuk event (mobile, opsional)",
        "deprecated": false,
        "description": "",
        "operationId": "registerPush",
        "tags": [
          "notification"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSubscription"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Tersimpan terenkripsi; dihapus saat penjualan berakhir",
            "headers": {}
          }
        },
        "security": [
          {
            "visitorHeader3": []
          }
        ]
      }
    },
    "/api/v1/push-subscriptions/{eventId}": {
      "delete": {
        "summary": "Hapus token push",
        "deprecated": false,
        "description": "",
        "operationId": "deletePush",
        "tags": [
          "notification"
        ],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "",
            "required": true,
            "example": "",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Dihapus",
            "headers": {}
          }
        },
        "security": [
          {
            "visitorHeader3": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health (ALB dan HEALTHCHECK container, D-23)",
        "deprecated": false,
        "description": "",
        "operationId": "health",
        "tags": [
          "ops"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Semua dependency UP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "Ada dependency DOWN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "visitorHeader3": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "meta",
          "data"
        ],
        "description": "Error envelope SRS §3.1.4. Tidak pernah memuat SQL, stack trace, secret, atau payload provider."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UP",
                    "DOWN"
                  ]
                },
                "latencyMs": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "checkedAt",
          "dependencies"
        ]
      },
      "PushSubscription": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ANDROID",
              "IOS"
            ]
          },
          "pushToken": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "eventId",
          "platform",
          "pushToken"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {
      "visitorHeader3": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Visitor-Token",
        "description": "Visitor token mobile (secure storage)"
      }
    }
  },
  "servers": [],
  "security": [
    {
      "visitorHeader3": []
    }
  ]
}