{
  "openapi": "3.0.1",
  "info": {
    "title": "1. User Service API",
    "description": "Akun opsional (ADR-020): login OTP email tanpa password, rotasi refresh token, profil. Guest checkout tidak membutuhkan service ini.",
    "version": "1.0.0",
    "contact": {
      "name": "Tim PT. Tiket Sampai Nonton Sentosa"
    }
  },
  "tags": [
    {
      "name": "auth"
    },
    {
      "name": "profile"
    },
    {
      "name": "ops"
    }
  ],
  "paths": {
    "/api/v1/auth/otp/request": {
      "post": {
        "summary": "Kirim kode OTP 6 digit ke email",
        "deprecated": false,
        "description": "Respons sama untuk email terdaftar maupun belum (anti enumerasi). Batas: OTP_MAX_PER_EMAIL_HOUR per email, OTP_MAX_PER_IP_HOUR per IP, cooldown OTP_RESEND_COOLDOWN.",
        "operationId": "requestOtp",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOTPRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/RequestOTPResponse"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "Field tidak valid — errorCode: `VALIDATION_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "429": {
            "description": "Terlalu sering — errorCode: `OTP_RESEND_TOO_SOON`, `RATE_LIMITED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "Email belum bisa dikirim — errorCode: `DEPENDENCY_UNAVAILABLE`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "summary": "Tukar kode OTP dengan token; akun dibuat saat login pertama",
        "deprecated": false,
        "description": "",
        "operationId": "verifyOtp",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOTPRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/TokenResponse"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "Field tidak valid — errorCode: `VALIDATION_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Kode salah/kedaluwarsa (details.attemptsLeft) — errorCode: `OTP_INVALID`, `OTP_EXPIRED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "Akun dinonaktifkan — errorCode: `ACCOUNT_DISABLED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "429": {
            "description": "Terlalu banyak percobaan — errorCode: `OTP_LOCKED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Rotasi refresh token",
        "deprecated": false,
        "description": "Refresh token lama langsung dicabut. Token lama yang dipakai ulang mencabut semua sesi akun (deteksi pencurian).",
        "operationId": "refreshToken",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/TokenResponse"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Sesi tidak valid — errorCode: `SESSION_INVALID`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "Akun dinonaktifkan — errorCode: `ACCOUNT_DISABLED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Cabut sesi (idempoten)",
        "deprecated": false,
        "description": "",
        "operationId": "logout",
        "tags": [
          "auth"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Sesi dicabut (atau memang tidak ada)",
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Profil pembeli yang login",
        "deprecated": false,
        "description": "",
        "operationId": "getMe",
        "tags": [
          "profile"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Access token tidak valid — errorCode: `UNAUTHORIZED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "userBearer": []
          }
        ]
      },
      "patch": {
        "summary": "Ubah nama dan/atau NIK tersimpan",
        "deprecated": false,
        "description": "NIK disimpan terenkripsi (AES-256-GCM) dan unik antar akun; respons hanya memuat NIK tersamar.",
        "operationId": "updateMe",
        "tags": [
          "profile"
        ],
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "Field tidak valid — errorCode: `VALIDATION_ERROR`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Access token tidak valid — errorCode: `UNAUTHORIZED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          },
          "409": {
            "description": "NIK sudah tertaut ke akun lain — errorCode: `NIK_ALREADY_LINKED`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "userBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health (ALB dan HEALTHCHECK container, D-23)",
        "deprecated": false,
        "description": "",
        "operationId": "health",
        "tags": [
          "ops"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Semua dependency UP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "Ada dependency DOWN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "meta",
          "data"
        ],
        "description": "Error envelope SRS §3.1.4. Tidak pernah memuat SQL, stack trace, secret, atau payload provider."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UP",
                    "DOWN"
                  ]
                },
                "latencyMs": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "checkedAt",
          "dependencies"
        ]
      },
      "RequestOTPRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "RequestOTPResponse": {
        "type": "object",
        "properties": {
          "expiresInSeconds": {
            "type": "integer"
          },
          "resendAfterSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "VerifyOTPRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "emailMasked": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "nikMasked": {
            "type": "string",
            "description": "NIK tersamar",
            "example": "3174********0001"
          },
          "hasNik": {
            "type": "boolean"
          }
        },
        "required": [
          "accountId",
          "emailMasked",
          "hasNik"
        ]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "const": "Bearer"
          },
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/Profile"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt",
          "account"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "nik": {
            "type": "string",
            "pattern": "^[0-9]{16}$",
            "description": "NIK 16 digit (dicek strukturnya; tidak pernah disimpan plaintext)"
          }
        },
        "description": "Field yang tidak dikirim tidak diubah; minimal satu field",
        "minProperties": 1,
        "additionalProperties": false
      }
    },
    "responses": {},
    "securitySchemes": {
      "userBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT (EdDSA)",
        "description": "Access token User Service (login OTP, opsional)"
      }
    }
  },
  "servers": [
    {
      "url": "",
      "description": "Develop Env"
    }
  ],
  "security": []
}