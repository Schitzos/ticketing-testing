{
  "name": "rusuh-booking-mobile",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace apps/client",
    "web": "npm run web --workspace apps/client",
    "android": "npm run android --workspace apps/client",
    "ios": "npm run ios --workspace apps/client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:ci": "jest --ci --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^9.2.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "expo": "~52.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "^18.3.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "query-string": "^7.1.3"
  },
  "overrides": {
    "decode-uri-component": "^0.5.1"
  }
}
