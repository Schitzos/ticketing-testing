  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "meta",
          "data"
        ],
        "description": "Error envelope SRS §3.1.4. Tidak pernah memuat SQL, stack trace, secret, atau payload provider."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UP",
                    "DOWN"
                  ]
                },
                "latencyMs": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "checkedAt",
          "dependencies"
        ]
      },
      "AllocationBatchRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "queueEntryId": {
                  "type": "string",
                  "format": "uuid"
                },
                "seq": {
                  "type": "integer"
                },
                "visitorId": {
                  "type": "string",
                  "format": "uuid"
                },
                "buyerNikHash": {
                  "type": "string",
                  "description": "hex HMAC"
                },
                "buyerNikMasked": {
                  "type": "string",
                  "description": "NIK tersamar",
                  "example": "3174********0001"
                },
                "buyerEmail": {
                  "type": "string",
                  "format": "email"
                },
                "accountId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Akun pembeli bila login (ADR-020)",
                  "nullable": true
                }
              },
              "required": [
                "queueEntryId",
                "seq",
                "visitorId",
                "buyerNikHash",
                "buyerNikMasked",
                "buyerEmail"
              ]
            }
          }
        },
        "required": [
          "eventId",
          "entries"
        ]
      },
      "AllocationBatchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "queueEntryId": {
                  "type": "string",
                  "format": "uuid"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "GRANTED",
                    "NO_SUPPLY_NOW",
                    "SOLD_OUT",
                    "BUYER_QUOTA_EXHAUSTED",
                    "ALREADY_ACTIVE"
                  ]
                },
                "allocationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "units": {
                  "type": "integer"
                },
                "claimDeadline": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "queueEntryId",
                "outcome"
              ]
            }
          }
        },
        "required": [
          "results"
        ]
      },
      "ReleaseRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "QUEUE_ENTRY_GONE"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "ReleaseResponse": {
        "type": "object",
        "properties": {
          "released": {
            "type": "boolean"
          }
        },
        "required": [
          "released"
        ]
      },
      "Supply": {
        "type": "object",
        "properties": {
          "free": {
            "type": "integer"
          },
          "allocated": {
            "type": "integer"
          },
          "held": {
            "type": "integer"
          },
          "sold": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "maxPerOrder": {
            "type": "integer"
          },
          "saleState": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "OPEN",
              "CLOSED"
            ]
          },
          "soldOut": {
            "type": "boolean"
          },
          "version": {
            "type": "integer"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "capacity": {
                  "type": "integer"
                },
                "available": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "required": [
          "free",
          "allocated",
          "held",
          "sold",
          "total",
          "saleState",
          "soldOut",
          "version"
        ]
      },
      "Payable": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Minor unit IDR"
          },
          "paymentExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "visitorId": {
            "type": "string",
            "format": "uuid"
          },
          "buyerEmail": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "canEdit": {
            "type": "boolean"
          }
        },
        "required": [
          "bookingId",
          "status",
          "amountMinor",
          "paymentExpiresAt",
          "version"
        ]
      },
      "PaymentLockRequest": {
        "type": "object",
        "properties": {
          "attemptKey": {
            "type": "string"
          }
        },
        "required": [
          "attemptKey"
        ]
      },
      "PaymentLockResponse": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "OK",
              "BOOKING_NOT_PAYABLE",
              "PAYMENT_EXPIRED"
            ]
          },
          "version": {
            "type": "integer"
          },
          "amountMinor": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Minor unit IDR"
          },
          "paymentExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "DeadlineExtensionRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "PROVIDER_UNAVAILABLE"
            ]
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          }
        },
        "required": [
          "reason",
          "seconds"
        ]
      },
      "DeadlineExtensionResponse": {
        "type": "object",
        "properties": {
          "paymentExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "extended": {
            "type": "boolean"
          }
        },
        "required": [
          "paymentExpiresAt",
          "extended"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {
      "serviceBearer1": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT (EdDSA)",
        "description": "Service token antar service (ADR-011)"
      }
    }
  },
  "servers": [],
  "security": [
    {
      "serviceBearer1": []
    }
  ]
}