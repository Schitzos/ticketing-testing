    "/health": {
      "get": {
        "summary": "Health (ALB dan HEALTHCHECK container, D-23)",
        "deprecated": false,
        "description": "",
        "operationId": "health",
        "tags": [
          "ops"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Semua dependency UP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "Ada dependency DOWN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          }
        },
