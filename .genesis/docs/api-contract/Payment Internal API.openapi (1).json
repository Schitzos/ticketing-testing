{
  "openapi": "3.0.1",
  "info": {
    "title": "Payment Internal API",
    "description": "Dipanggil worker Booking. Selalu `Authorization: Bearer <service token>`.",
    "version": "1.0.0",
    "contact": {
      "name": "Tim PT. Tiket Sampai Nonton Sentosa"
    }
  },
  "tags": [
    {
      "name": "internal"
    },
    {
      "name": "ops"
    }
  ],
  "paths": {
    "/internal/v1/payments/{bookingId}/resolve": {
      "post": {
        "summary": "Cek ulang ke gateway sebelum expire (dipanggil sweeper Booking)",
        "deprecated": false,
        "description": "",
        "operationId": "resolvePayment",
        "tags": [
          "internal"
        ],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "description": "",
            "required": true,
            "example": "",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ResolveResponse"
                    }
                  },
                  "required": [
                    "meta",
                    "data"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "serviceBearer": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health (ALB dan HEALTHCHECK container, D-23)",
        "deprecated": false,
        "description": "",
        "operationId": "health",
        "tags": [
          "ops"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Semua dependency UP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          },
          "503": {
            "description": "Ada dependency DOWN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {}
          }
        },
        "security": [
          {
            "serviceBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "null"
          }
        },
        "required": [
          "meta",
          "data"
        ],
        "description": "Error envelope SRS §3.1.4. Tidak pernah memuat SQL, stack trace, secret, atau payload provider."
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "UP",
                    "DOWN"
                  ]
                },
                "latencyMs": {
                  "type": "integer"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          }
        },
        "required": [
          "status",
          "service",
          "checkedAt",
          "dependencies"
        ]
      },
      "ResolveRequest": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "CHECK",
              "CHECK_AND_CANCEL"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "ResolveResponse": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "NOT_PAID",
              "NO_ATTEMPT",
              "UNKNOWN"
            ]
          },
          "settlementTime": {
            "type": "string",
            "format": "date-time"
          },
          "attemptId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "outcome"
        ]
      }
    },
    "responses": {},
    "securitySchemes": {
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT (EdDSA)",
        "description": "Service token antar service (ADR-011)"
      }
    }
  },
  "servers": [],
  "security": [
    {
      "serviceBearer": []
    }
  ]
}